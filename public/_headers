/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Стили: ссылки на них с версией (?v=хэш, scripts/stamp-assets.py), поэтому
# браузер держит их долго. А вот CDN VK Cloud хранить их не должен: он кладёт
# в кэш один сжатый вариант и отдаёт его всем подряд — zstd получал и Safari,
# который его не читает. private оставляет кэш только браузеру.
/css/*
  Cache-Control: private, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# Страницы — большие, но статичные. Держим в кэше браузера недолго,
# на edge Cloudflare кэширует их сам.
/*.html
  Cache-Control: public, max-age=3600
